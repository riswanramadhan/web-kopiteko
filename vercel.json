{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?:www[.]kopiteko[.]com|kopiteko[.]com)"
        }
      ],
      "destination": "https://kopiteko.dekatlokal.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/Asset/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.png|favicon-48x48.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
